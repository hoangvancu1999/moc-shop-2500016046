rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdminAuth() {
      return request.auth != null && request.auth.token.email == "hoangvancu1999@gmail.com";
    }

    function isAdminWrite() {
      return isAdminAuth() || (
        request.resource.data._adminToken is string &&
        request.resource.data._adminToken.size() >= 32 &&
        exists(/databases/$(database)/documents/gc_admin_sessions/$(request.resource.data._adminToken))
      );
    }

    // Collection đơn hàng cũ (giữ tương thích)
    match /donhang/{orderId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Khóa xác thực Admin
    match /gc_secrets/admin {
      allow create: if !exists(/databases/$(database)/documents/gc_secrets/admin) &&
                    request.resource.data.keyHash is string &&
                    request.resource.data.keyHash.size() == 64;
      allow update: if isAdminWrite() &&
                    request.resource.data.keyHash is string &&
                    request.resource.data.keyHash.size() == 64;
      allow read, delete: if false;
    }

    match /gc_secrets/vault {
      allow get: if true;
      allow create: if !exists(/databases/$(database)/documents/gc_secrets/vault);
      allow update: if isAdminWrite();
      allow list, delete: if false;
    }

    match /gc_orders_private/{bookingCode} {
      allow create: if true;
      allow read, update, delete: if isAdminAuth();
    }

    match /shop_orders_private/{orderCode} {
      allow create: if true;
      allow read, update, delete: if isAdminAuth();
    }

    match /gc_admin_sessions/{token} {
      allow create: if exists(/databases/$(database)/documents/gc_secrets/admin) &&
                    request.resource.data.keyHash == get(/databases/$(database)/documents/gc_secrets/admin).data.keyHash;
      allow read, update, delete: if false;
    }

    // === HỆ THỐNG THÀNH VIÊN & VÍ SỐ DƯ (CHỐNG GIAN LẬN F12 TUYỆT ĐỐI) ===
    match /users/{uid} {
      // Thành viên đọc ví của mình; Admin xem danh sách thành viên để quản lý số dư
      allow get: if (request.auth != null && request.auth.uid == uid) || isAdminAuth();
      allow list: if true;

      // Đăng ký mới: bắt buộc số dư khởi tạo bằng 0
      allow create: if request.auth != null &&
                    request.auth.uid == uid &&
                    request.resource.data.balance == 0 &&
                    request.resource.data.totalDeposited == 0;

      // Cập nhật số dư:
      // 1) Admin cộng/điều chỉnh số dư khi duyệt nạp tiền
      // 2) Thành viên tự trừ tiền nguyên tử (writeBatch) đúng bằng giá Account chưa bán
      allow update: if isAdminWrite() || (
        request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["balance", "lastPurchasedAccId", "updatedAtISO"]) &&
        request.resource.data.balance >= 0 &&
        request.resource.data.balance < resource.data.balance &&
        request.resource.data.lastPurchasedAccId is string &&
        get(/databases/$(database)/documents/shop_accounts/$(request.resource.data.lastPurchasedAccId)).data.sold == false &&
        getAfter(/databases/$(database)/documents/shop_accounts/$(request.resource.data.lastPurchasedAccId)).data.sold == true &&
        getAfter(/databases/$(database)/documents/shop_accounts/$(request.resource.data.lastPurchasedAccId)).data.buyerUid == request.auth.uid &&
        (resource.data.balance - request.resource.data.balance) ==
          get(/databases/$(database)/documents/shop_accounts/$(request.resource.data.lastPurchasedAccId)).data.price
      );
      allow delete: if isAdminAuth();
    }

    // Yêu cầu nạp tiền qua VietQR MB Bank
    match /wallet_topups/{topupCode} {
      allow read: if true;
      allow create: if request.auth != null &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.status == "Pending" &&
                    request.resource.data.amount is int &&
                    request.resource.data.amount >= 10000;
      allow update: if isAdminWrite() || (
        request.auth != null &&
        resource.data.uid == request.auth.uid &&
        resource.data.status == "Pending" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]) &&
        request.resource.data.status == "Reported_Paid"
      );
      allow delete: if isAdminAuth();
    }

    // Lịch sử mua Account bằng số dư của từng thành viên
    match /user_purchases/{purchaseId} {
      allow read: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdminAuth();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdminWrite();
    }

    // === KHO ACCOUNT & MỞ KHÓA TÀI KHOẢN / MẬT KHẨU TỰ ĐỘNG ===
    match /shop_accounts/{accId} {
      allow read: if true;
      allow create: if isAdminWrite();
      // Admin sửa kho HOẶC khách mua hợp lệ (đã trừ đủ tiền trong cùng giao dịch nguyên tử getAfter)
      allow update: if isAdminWrite() || (
        request.auth != null &&
        resource.data.sold == false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sold", "badge", "buyerUid", "soldAtISO"]) &&
        request.resource.data.sold == true &&
        request.resource.data.buyerUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.balance >= 0 &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.balance ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.balance - resource.data.price
      );
      allow delete: if isAdminAuth();
    }

    // Két mật khẩu phục vụ mở khóa TỨC THÌ 24/7 cho đúng người mua (CẤM list tuyệt đối!)
    match /shop_account_secrets/{accId} {
      allow get: if isAdminAuth() || (
        request.auth != null &&
        get(/databases/$(database)/documents/shop_accounts/$(accId)).data.sold == true &&
        get(/databases/$(database)/documents/shop_accounts/$(accId)).data.buyerUid == request.auth.uid
      );
      allow list: if false;
      allow create, update: if isAdminWrite();
      allow delete: if isAdminAuth();
    }

    // Két mã hóa RSA phục vụ hiển thị trong bảng Admin
    match /shop_vault_stock/{accId} {
      allow read: if true;
      allow create, update: if isAdminWrite();
      allow delete: if isAdminAuth();
    }

    match /shop_orders/{maDon} {
      allow read: if true;
      allow create: if request.resource.data.paymentStatus == "Awaiting_Transfer" &&
                    !("soDienThoai" in request.resource.data) &&
                    !("deliveryToken" in request.resource.data);
      allow update: if isAdminWrite() || (
        resource.data.paymentStatus == "Awaiting_Transfer" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentStatus"]) &&
        request.resource.data.paymentStatus == "Customer_Marked_Paid"
      );
      allow delete: if isAdminAuth();
    }

    match /shop_deliveries/{deliveryToken} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdminWrite();
      allow delete: if isAdminAuth();
    }

    // === DỊCH VỤ GAME CÙNG DELTA FORCE ===
    match /gc_packages/{pkgId} {
      allow read: if true;
      allow create, update: if isAdminWrite();
      allow delete: if isAdminAuth();
    }

    match /gc_maps/{mapId} {
      allow read: if true;
      allow create, update: if isAdminWrite();
      allow delete: if isAdminAuth();
    }

    match /gc_config/{docId} {
      allow read: if true;
      allow create, update: if isAdminWrite();
      allow delete: if isAdminAuth();
    }

    match /gc_orders/{bookingCode} {
      allow read: if true;
      allow create: if request.resource.data.status == "Pending" &&
                    !("discordId" in request.resource.data) &&
                    !("customerName" in request.resource.data) &&
                    !("gameId" in request.resource.data);
      allow update: if isAdminWrite() || (
        resource.data.status == "Completed" &&
        resource.data.reviewed == false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reviewed"]) &&
        request.resource.data.reviewed == true
      );
      allow delete: if isAdminAuth();
    }

    match /gc_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.bookingCode is string &&
                    exists(/databases/$(database)/documents/gc_orders/$(request.resource.data.bookingCode)) &&
                    get(/databases/$(database)/documents/gc_orders/$(request.resource.data.bookingCode)).data.status == "Completed" &&
                    get(/databases/$(database)/documents/gc_orders/$(request.resource.data.bookingCode)).data.reviewed == false &&
                    request.resource.data.verified == true &&
                    !("discordId" in request.resource.data);
      allow update: if isAdminWrite();
      allow delete: if isAdminAuth();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
